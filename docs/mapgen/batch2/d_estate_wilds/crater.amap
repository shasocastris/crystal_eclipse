MMW,............,""EMM
MMW,o,,,,,,,,,,,"",EMM
MMW"",,,,,..,,,,,""EMM
MMW""o,,,,..,,,o""oEMM
MMVLLLLLLY..ZLLLLLLVMM
MMMMMMMMMW..EMMMMMMMMM
MMMMMMMMMW..EMMMMMMMMM
end
exit S 20 39
exit CAVE 28 5
exit ISLAND 19 20
